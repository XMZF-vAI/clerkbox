{
  "name": "clerkbox",
  "version": "1.7.5",
  "description": "XMZF vAI - ClerkBox: Single AI Agent Desktop Workbench",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run build:electron\" \"vite\" \"wait-on http://localhost:5175 && cross-env VITE_DEV_SERVER_URL=http://localhost:5175 electron .\"",
    "dev:alt": "concurrently \"npm run build:electron\" \"vite\" \"wait-on http://localhost:5176 && cross-env VITE_DEV_SERVER_URL=http://localhost:5176 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "electron": "npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5175 electron .",
    "build": "npm run build:electron && vite build && electron-builder --win",
    "preview": "vite preview"
  },
  "keywords": [
    "ai",
    "agent",
    "electron",
    "xmzf"
  ],
  "author": "XMZF Studio",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^6.0.195",
    "cheerio": "^1.2.0",
    "i18next": "^26.3.6",
    "iconv-lite": "^0.7.3",
    "js-yaml": "^4.3.1",
    "lucide-react": "^1.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^5.4.21",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.xmzf.clerkbox",
    "productName": "ClerkBox",
    "directories": {
      "output": "release-out",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "electronUpdaterCompatibility": ">=2.16.0",
    "publish": {
      "provider": "github",
      "owner": "XMZF-vAI",
      "repo": "clerkbox"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClerkBox",
      "unicode": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
